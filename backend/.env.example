APP_ENV=development
PORT=3001
# Comma-separated exact origins. Wildcards and URL paths are rejected.
FRONTEND_URLS=http://localhost:5173
# 0 for direct local traffic; Render should be configured explicitly with 1.
TRUST_PROXY_HOPS=0
REQUEST_TIMEOUT_MS=25000
SHUTDOWN_GRACE_MS=10000
READINESS_TIMEOUT_MS=2000
READINESS_CACHE_MS=5000
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_MAX_ENTRIES=10000
# memory is allowed only for development/test. Deployed environments require
# supabase and the consume_public_rate_limit RPC migration.
PUBLIC_RATE_LIMIT_STORE=memory
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only. Never create VITE_, NEXT_PUBLIC_, or PUBLIC_ variants.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# OCR_SPACE_API_KEY=your-optional-ocr-key
